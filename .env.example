# All settings are optional; defaults shown.
NCAAF_CLV_DATA_DIR=data
NCAAF_CLV_SEASON_YEAR=2026
NCAAF_CLV_ESPN_GROUP_ID=80            # 80 = FBS
NCAAF_CLV_HTTP_TIMEOUT_S=30
NCAAF_CLV_MAX_CONCURRENCY=6           # parallel ESPN requests
NCAAF_CLV_RATE_LIMIT_PER_S=8          # global request rate cap
NCAAF_CLV_MAX_RETRIES=4
NCAAF_CLV_OVERTIME_TZ=America/New_York  # tz of Overtime.ag GameDateTimeString
NCAAF_CLV_JOIN_WINDOW_HOURS=12        # kickoff tolerance when joining odds to ESPN games
NCAAF_CLV_LOG_LEVEL=INFO
# Empty = httpx default (python-httpx/x.y), which ESPN accepts. Browser-style and bare custom agents
# (ncaaf-clv/0.1) are refused with 403. Keep comments on their own line: an inline comment becomes the value.
NCAAF_CLV_ESPN_USER_AGENT=

# AccuWeather stadium weather (ncaaf-clv weather ...). Key: https://developer.accuweather.com (Locations + Forecast +
# Current Conditions APIs). Unprefixed ACCUWEATHER_API_KEY is honoured too.
ACCUWEATHER_API_KEY=
NCAAF_CLV_ACCUWEATHER_BASE_URL=https://dataservice.accuweather.com
NCAAF_CLV_ACCUWEATHER_HOURLY_HOURS=12   # forecast horizon: 12 on the free/starter tier; 24/72/120/240 need a paid plan
NCAAF_CLV_ACCUWEATHER_RATE_LIMIT_PER_S=1
NCAAF_CLV_ACCUWEATHER_CALL_BUDGET=0     # stop a run after N API calls (0 = unlimited); trial keys allow 50/day
NCAAF_CLV_WEATHER_PRE_KICKOFF_HOURS=1   # game window starts this long before kickoff ...
NCAAF_CLV_WEATHER_GAME_DURATION_HOURS=3.5   # ... and ends this long after it (typical FBS game is 3-3.5 h)
NCAAF_CLV_WEATHER_LOCATIONS_FILE=data/reference/stadium_locations.json  # venue -> location key registry (commit it)
